BASETEN_API_KEY=
# Only needed with MODEL_PROVIDER=meta. MODEL_API_KEY works as a generic name. META_API_KEY wins if both are set.
META_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional, defaults shown
# PORT=3000
# FRONTEND_ORIGIN=http://localhost:5173
# DB_PATH=server/data/savedtoaction.db
# SCREENSHOT_DIR=server/data/screenshots
# MODEL_PROVIDER=baseten   (baseten is the default, or meta)
# META_BASE_URL=https://api.meta.ai/v1   (no trailing slash)
# META_MODEL=muse-spark-1.3
# META_FORCED_TOOL_CHOICE=auto   (auto asks with an instruction. required only after scripts/meta-smoke.mjs shows Meta accepts it)
# META_REASONING_EFFORT=low   (off sends nothing. If Meta rejects it with a 400, the call is retried once without it)
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_REASONING_EFFORT=low   (default is low, use "off" to send no reasoning_effort)

# Account login is on by default. Use off only for an isolated local legacy workspace.
AUTH_MODE=on
# Optional: uses GOOGLE_REDIRECT_URI by default, sharing the registered Calendar callback.
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/login/google/callback
# OWNER_EMAIL=
# DATA_DIR=data
# COOKIE_SECURE=true
# TOKEN_ENC_KEY=64_hex_characters_required_in_production
# FREE_DAILY_CREDITS=20
